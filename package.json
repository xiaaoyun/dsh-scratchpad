{
  "name": "dsh-scratchpad",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "A scratchpad in the DSH sidebar: tagged notes with a tag filter, Markdown to-do lists you can tick, image/file attachments (paste or drop, with a size budget), JSON export/import, and copy-to-clipboard. Notes stay in this browser.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaaoyun/dsh-scratchpad.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "check": "node --check client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
